{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zjzonline/DeskBox-Themes/blob/deskbox-themes/themes/schema-v1.json",
  "title": "DeskBox data-only theme pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "minimumDeskBoxVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "localizedNames": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}([+-][A-Za-z0-9.-]+)?$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "minimumDeskBoxVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}([+-][A-Za-z0-9.-]+)?$" },
    "preview": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.(png|jpg|jpeg|webp|svg)$"
    },
    "visuals": { "$ref": "#/$defs/visuals" },
    "motion": { "$ref": "#/$defs/motion" }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "visuals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaceColor": { "$ref": "#/$defs/color" },
        "deepSurfaceColor": { "$ref": "#/$defs/color" },
        "textPrimaryColor": { "$ref": "#/$defs/color" },
        "textSecondaryColor": { "$ref": "#/$defs/color" },
        "accentColor": { "$ref": "#/$defs/color" },
        "edgeStartColor": { "$ref": "#/$defs/color" },
        "edgeEndColor": { "$ref": "#/$defs/color" },
        "specularColor": { "$ref": "#/$defs/color" },
        "shadowColor": { "$ref": "#/$defs/color" },
        "surfaceOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 64 },
        "borderThickness": { "type": "number", "minimum": 0, "maximum": 8 },
        "innerBorderThickness": { "type": "number", "minimum": 0, "maximum": 8 },
        "elevation": { "type": "number", "minimum": 0, "maximum": 64 },
        "specularOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "material": {
          "type": "string",
          "enum": ["Mica", "MicaAlt", "Acrylic", "AcrylicBase", "Solid"]
        },
        "deepSurfaceWidgetKinds": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openDurationMilliseconds": { "type": "integer", "minimum": 80, "maximum": 1200 },
        "closeDurationMilliseconds": { "type": "integer", "minimum": 80, "maximum": 1200 },
        "hoverScale": { "type": "number", "minimum": 1, "maximum": 1.08 },
        "pressScale": { "type": "number", "minimum": 0.88, "maximum": 1 },
        "springDamping": { "type": "number", "minimum": 0.3, "maximum": 1 }
      }
    }
  }
}
